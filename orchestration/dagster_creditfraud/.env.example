# Never commit the real .env file.
S3_BUCKET=intern-final-project-fraud-detection
S3_LANDING_PREFIX=landing/
AWS_REGION=ap-south-1
# Optional: process only objects uploaded after this UTC timestamp on the
# first sensor rollout, for example 2026-08-07T18:00:00Z.
S3_SENSOR_START_AFTER=
# Let boto3 use a named AWS CLI profile, or set AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY outside this repository.
AWS_PROFILE=fraud-detection

# Optional final-failure notifications through Amazon SNS. Subscribe one or
# more email endpoints to this topic in the AWS Console.
SNS_FAILURE_TOPIC_ARN=arn:aws:sns:ap-south-1:288761766697:fraud-pipeline-failure-alerts

DATABRICKS_HOST=https://<your-databricks-workspace-url>
DATABRICKS_TOKEN=<databricks-personal-access-token>
DATABRICKS_BRONZE_JOB_ID=<bronze-job-id>
DATABRICKS_SILVER_JOB_ID=<silver-job-id>
DATABRICKS_SNOWFLAKE_LOAD_JOB_ID=<snowflake-load-job-id>
PIPELINE_CATALOG_NAME=workspace

SNOWFLAKE_ACCOUNT=zt63149.ap-south-1.aws
SNOWFLAKE_USER=<snowflake-user>
SNOWFLAKE_PASSWORD=<snowflake-password>
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FRAUD_WH
SNOWFLAKE_DATABASE=FRAUD_DB
